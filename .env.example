ANTHROPIC_API_KEY=your_api_key_here

# Optional: override default model
ANALYSIS_MODEL=claude-opus-4-7
DESIGN_MODEL=claude-opus-4-7

# Optional: path to openscad binary (default: openscad)
OPENSCAD_PATH=openscad

# Optional: output directory (default: ./output)
OUTPUT_DIR=./output

# Optional: max print bed dimensions in mm (default: Ender 3 Pro)
PRINT_BED_X=220
PRINT_BED_Y=220
PRINT_BED_Z=250
