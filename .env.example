# ── LLM Provider (pick one) ────────────────────────────────────────────────
#
# Option A: OpenRouter (supports Claude + many other models)
#   Register free: https://openrouter.ai → Settings → API Keys
OPENROUTER_API_KEY=your_openrouter_key_here
#   Optional: override default model (default: anthropic/claude-3.5-sonnet)
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
#
# Option B: Anthropic direct
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Mesh generation backends ────────────────────────────────────────────────
# tripo3d: free tier allows mesh downloads
#   Register free: https://platform.tripo3d.ai
TRIPO3D_API_KEY=your_tripo3d_key_here

# meshy: paid tier required for downloads
MESHY_API_KEY=your_meshy_key_here

# ── OpenSCAD binary (parametric mode) ─────────────────────────────────────
OPENSCAD_PATH=openscad

# ── Output directory ───────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Print bed dimensions in mm (default: Ender 3 Pro) ─────────────────────
PRINT_BED_X=220
PRINT_BED_Y=220
PRINT_BED_Z=250
