ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Mesh generation mode (organic / artistic objects) ──────────────────────
# Get a key at https://www.meshy.ai  (free tier available)
MESHY_API_KEY=your_meshy_key_here

# ── Model overrides ────────────────────────────────────────────────────────
ANALYSIS_MODEL=claude-opus-4-7
DESIGN_MODEL=claude-opus-4-7

# ── OpenSCAD binary (parametric mode) ─────────────────────────────────────
# Default: openscad  (install from https://openscad.org)
OPENSCAD_PATH=openscad

# ── Output directory ───────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Print bed dimensions in mm (default: Ender 3 Pro) ─────────────────────
PRINT_BED_X=220
PRINT_BED_Y=220
PRINT_BED_Z=250
