# ╔══════════════════════════════════════════════════════════════════╗
# ║              Nanoclaw — Environment Configuration               ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── LLM Provider (choose ONE of A / B / C) ──────────────────────────────────

# ┌─ Option A: OpenRouter (recommended) ──────────────────────────────────────
# │  One key, access to Claude + GPT + Gemini + local models
# │  Register free: https://openrouter.ai → Settings → API Keys
OPENROUTER_API_KEY=your_openrouter_key_here

# │  Model selection (default: Sonnet — best value)
# │  Uncomment one line to override:
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-5              # default — ~$0.09/run
# OPENROUTER_MODEL=anthropic/claude-haiku-3-5               # cheapest — ~$0.02/run
# OPENROUTER_MODEL=anthropic/claude-opus-4-5                # best quality — ~$0.44/run
# OPENROUTER_MODEL=openai/gpt-4o                            # OpenAI alternative
# OPENROUTER_MODEL=google/gemini-pro-1.5                    # Google alternative
# OPENROUTER_MODEL=perplexity/llama-3.1-sonar-large-128k-online  # Perplexity
# OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free  # Hermes (free tier)

# │  Bring Your Own Key (BYOK) — use YOUR Anthropic/Perplexity key via OpenRouter
# │  Benefits: cheaper rates, your own rate limits, direct billing
# │  How to set up: openrouter.ai → Settings → Integrations → Add provider key
# │  Then use the same OPENROUTER_API_KEY above — OpenRouter routes via your key
# │  See: https://openrouter.ai/docs/provider-routing
# └───────────────────────────────────────────────────────────────────────────

# ┌─ Option B: Anthropic direct ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here
# └───────────────────────────────────────────────────────────────────────────

# ┌─ Option C: Ollama (FREE — runs 100% locally, no internet needed) ──────────
# │  Install: https://ollama.ai → then: ollama pull llama3.2
# │  Start:   ollama serve
# USE_OLLAMA=1
# OLLAMA_MODEL=llama3.2         # default (fast, 2 GB)
# OLLAMA_MODEL=llama3.1:8b      # better quality (5 GB)
# OLLAMA_MODEL=codellama:13b    # best for OpenSCAD code (8 GB)
# OLLAMA_MODEL=mistral          # alternative
# └───────────────────────────────────────────────────────────────────────────

# ── Per-agent model override (optional) ─────────────────────────────────────
# Override which model each agent uses independently:
# ANALYSIS_MODEL=claude-haiku-4-5    # cheapest for simple image analysis
# DESIGN_MODEL=claude-sonnet-4-6     # default — good quality/cost balance
# DESIGN_MODEL=claude-opus-4-7       # use only for very complex objects

# ── Mesh generation backends ────────────────────────────────────────────────
# tripo3d: free tier allows mesh downloads
#   Register free: https://platform.tripo3d.ai
TRIPO3D_API_KEY=your_tripo3d_key_here

# meshy: paid tier required for downloads
# MESHY_API_KEY=your_meshy_key_here

# ── OpenSCAD binary (parametric mode — optional) ────────────────────────────
# Install from https://openscad.org/downloads.html
# If not installed, SCAD files are generated but STL rendering is skipped.
OPENSCAD_PATH=openscad

# ── Output directory ────────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Web UI port ─────────────────────────────────────────────────────────────
UI_PORT=7860

# ── Print bed dimensions in mm (default: Ender 3 Pro) ───────────────────────
PRINT_BED_X=220
PRINT_BED_Y=220
PRINT_BED_Z=250

# ── part-gen path (CadQuery templates — auto-detected) ──────────────────────
# Default: ~/Desktop/n8n-setup/part-gen
# Only needed if yours is in a different location:
# PARTGEN_PATH=/path/to/part-gen
