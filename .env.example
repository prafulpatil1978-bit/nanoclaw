ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Mesh generation backends ────────────────────────────────────────────────
#
# shape-e  → local/free, no key needed
#            pip install shap-e torch  (~1 GB model auto-downloads on first run)
#            Use:  python main.py generate -d "..." --backend shape-e
#
# tripo3d  → free tier allows mesh downloads
#            Register free: https://platform.tripo3d.ai
TRIPO3D_API_KEY=your_tripo3d_key_here
#            Use:  python main.py generate -d "..." --backend tripo3d
#
# meshy    → paid tier required for downloads (free = browser-only preview)
#            https://www.meshy.ai
MESHY_API_KEY=your_meshy_key_here
#            Use:  python main.py generate -d "..." --backend meshy

# ── Model overrides ────────────────────────────────────────────────────────
ANALYSIS_MODEL=claude-opus-4-7
DESIGN_MODEL=claude-opus-4-7

# ── OpenSCAD binary (parametric mode) ─────────────────────────────────────
OPENSCAD_PATH=openscad

# ── Output directory ───────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Print bed dimensions in mm (default: Ender 3 Pro) ─────────────────────
PRINT_BED_X=220
PRINT_BED_Y=220
PRINT_BED_Z=250
